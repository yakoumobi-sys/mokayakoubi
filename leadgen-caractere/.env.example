# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne commitez jamais le fichier ".env" (il est dans .gitignore).

# --- Recherche de leads (Google Places API - officielle) ---
# Créez une clé sur https://console.cloud.google.com/ (API "Places API (New)")
# Quota gratuit mensuel disponible, puis facturation à l'usage.
GOOGLE_PLACES_API_KEY=

# --- Envoi d'emails (SendGrid) ---
SENDGRID_API_KEY=
FROM_EMAIL=contact@caractere.fr
FROM_NAME=Caractère

# --- Identité utilisée dans les modèles de message ---
COMPANY_NAME=Caractère
SIGNATURE_NAME=
SIGNATURE_PHONE=

# --- Conformité (mention obligatoire de désinscription B2B / CNIL) ---
# Adresse ou moyen à utiliser pour se désinscrire, insérée dans les emails.
UNSUBSCRIBE_CONTACT=contact@caractere.fr

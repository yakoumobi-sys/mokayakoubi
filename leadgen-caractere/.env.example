# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne commitez jamais le fichier ".env" (il est dans .gitignore).

# --- Recherche de leads (Google Places API - officielle) ---
# Créez une clé sur https://console.cloud.google.com/ (API "Places API (New)")
# Quota gratuit mensuel disponible, puis facturation à l'usage.
# Fonctionne pour n'importe quel pays : indiquez juste la ville/pays dans
# --query (ex: "club de sport à Alger", "hôtel à Oran").
GOOGLE_PLACES_API_KEY=

# --- Indicatif pays par défaut pour normaliser les numéros de téléphone ---
# Utilisé pour transformer un numéro local ("0555 12 34 56") en format
# international ("+213555123456") requis pour les liens WhatsApp.
# Algérie = 213, France = 33, Tunisie = 216, Maroc = 212...
# (Sans effet sur les numéros que Google Places renvoie déjà au format
# international, ni sur ceux déjà saisis avec un "+" dans vos CSV.)
DEFAULT_COUNTRY_CODE=213

# --- Envoi d'emails (SendGrid) ---
SENDGRID_API_KEY=
FROM_EMAIL=contact@caractere.fr
FROM_NAME=Caractère

# --- Identité utilisée dans les modèles de message ---
COMPANY_NAME=Caractère
SIGNATURE_NAME=
SIGNATURE_PHONE=

# --- Conformité (mention obligatoire de désinscription B2B / CNIL) ---
# Adresse ou moyen à utiliser pour se désinscrire, insérée dans les emails.
UNSUBSCRIBE_CONTACT=contact@caractere.fr

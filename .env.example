# ============================================================================
#  Environment variables — all optional.
#  The site builds and runs fine with none of them set.
# ============================================================================

# --- Email capture (the "Get it free" form) ---------------------------------
# Pick ONE. Leave everything empty and the form politely says signups aren't
# open yet instead of pretending to work.

# Option A — any tool that accepts a POST with {"email": "...", "source": "..."}
# Beehiiv, ConvertKit, Brevo, Zapier, Make, n8n…
SUBSCRIBE_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_TOKEN=

# Option B — Supabase (uses the newsletter_subscribers table in database.sql)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override: webhook | supabase | none (auto-detected otherwise)
EMAIL_PROVIDER=
